      tempy = atan( 1 / temp2 )
    elseif ( @imagfront == 50 )
      tempy = acos( 1 / temp2 )
    elseif ( @imagfront == 51 )
      tempy = asin( 1 / temp2 )
    elseif ( @imagfront == 52 )
      tempy = tan( temp2 ) / temp2
    elseif ( @imagfront == 53 )
      tempy = cotan( temp2 ) / temp2
    elseif ( @imagfront == 54 )
      tempy = 1 / ( temp2 * cos( temp2 ))
    elseif ( @imagfront == 55 )
