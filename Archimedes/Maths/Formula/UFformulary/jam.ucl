      endif ; transmogrify2
    endif ; transmogrify1

    if @trapperturb
      tempc = @trapblend * tempc + trapbcomp * zold
    endif ; @trapperturb

    ; Initialize back end real, back end imag, if desired
    temp2 = @rbscale * real(tempc)

    if ( @realback == 0 )
