    elseif  @imagfront == 76
      tempy = cosh( temp2 )
      tempy = tempy * tempy
    elseif  @imagfront == 77
      tempy = tanh(temp2)
      tempy = tempy * tempy
    elseif  @imagfront == 78
      tempy = cotanh( temp2 )
      tempy = tempy * tempy
    elseif  @imagfront == 79
      tempy = 1/cosh(temp2)
      tempy = tempy * tempy
    elseif  @imagfront == 80
      tempy = 1 / sinh( temp2 )
