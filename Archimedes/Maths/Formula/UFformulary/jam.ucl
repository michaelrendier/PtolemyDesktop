      tempy = temp2 * cos( temp2 )
    elseif ( @imagfront == 58 )
      tempy = temp2 * tan( temp2 )
    elseif ( @imagfront == 59 )
      tempy = temp2 * cotan( temp2 )
    elseif ( @imagfront == 60 )
      tempy = temp2/cos( temp2 )
    elseif ( @imagfront == 61 )
      tempy = temp2/sin( temp2 )
    elseif ( @imagfront == 62 )
