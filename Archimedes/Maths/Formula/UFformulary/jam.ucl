      cangle = cangle + twopi
    endif ; cangle

    if @twavy
      if @twavmode == 0 ; radial mode
        temp = cabs( tempc )
        temp = temp + @twavamp * temp * sin( @twavfreq * cangle ) ; vary radius
        tempc = temp * exp( flip( cangle )) ; compute new tempc
      else ; tangential mode
        tempx = cabs( tempc )
        temp = cangle + @twavamp * cangle * sin( @twavfreq * tempx ) ; vary azimuth
        tempc = tempx * exp( flip( temp )) ; compute new tempc
        cangle = temp
      endif ; @twavmode
    endif ; @twavy

