          "t*e^(-t^2)" "t*e^(-1/(t^2))" "log(t) B" "log(log(t)) B" "sin(t^power)"
    default = 0
    hint = "The point, t, on the trap can be further transformed \
          prior to testing; select 't' for no transmutation.  \
          Transmutation does not affect a few trap flavors.  Transmutation \
          occurs before the two 'Back End' modulations"
    visible = @showmodulators
  endparam
  param tpower
    caption = "Trap Power"
    default = (4,0)
