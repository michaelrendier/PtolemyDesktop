    elseif  @realback == 96
      tempx = log(temp2)
      tempx = tempx*tempx
    elseif  @realback == 97
      tempx = sin(temp2) * sin(2*temp2)
    elseif  @realback == 98
      tempx = exp(2*temp2)
    elseif  @realback == 99
