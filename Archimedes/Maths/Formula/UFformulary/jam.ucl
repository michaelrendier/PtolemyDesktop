    elseif ( @realback == 32 )
      tempx = 1/sin( temp2 )
      tempx = tempx * tempx
    elseif ( @realback == 33 )
      tempx = temp2^(temp2)
      tempx = temp2^tempx
    elseif ( @realback == 34 )
      tempx = temp2^(temp2)
      tempx = 1/( temp2^tempx )
    elseif ( @realback == 35 )
      tempx = log(-temp2)
    elseif ( @realback == 36 )
      tempx = 1/log( temp2 )
    elseif ( @realback == 37 )
      tempx = temp2 * log( temp2 )
    elseif ( @realback == 38 )
      tempx = sin( temp2 ) / temp2
    elseif ( @realback == 39 )
