          "cosh(t)log(t)"
    default = 0
    hint = "The point, t, on the circle closest to the z iterate can be transformed \
          prior to testing for trapping; select 't' for no transmutation.  \
          Transmute does not work on the following trap flavors:  \
          2 (angle), 5 (magnitude), 7 (real), and 8 (imag)"
  endparam
  param tpower
    caption = "Trap Power"
    default = (0,1)
    hint = "Trap point t exponent if param 'Trap Transmute' is set to 't^power'"
    visible = @transmogrify == "t^power"
