          (@osc11amp != 0.0) && (@osc12amp != 0.0) && (@osc13amp != 0.0) && (@osc14amp != 0.0)
  endparam
  param oscrecip14
    caption = "Set A Osc 4 Reciprocal?"
    default = FALSE
    hint = "If enabled, Set A Oscillator 4 will use the reciprocal of the angular argument"
    visible = @showtrapfuncs && \
          (@traptype != "functions") \
          && (@osc11amp != 0.0) && (@osc12amp != 0.0) && (@osc13amp != 0.0) && (@osc14amp != 0.0)
