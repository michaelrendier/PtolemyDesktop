          && (@osc21amp != 0.0) && (@osc22amp != 0.0) && @oscpower22
  endparam
  param osc22sin
    caption = "SetB Osc2 Sine?"
    default = TRUE
    hint = "If enabled, then functions other than cosine can be used \
