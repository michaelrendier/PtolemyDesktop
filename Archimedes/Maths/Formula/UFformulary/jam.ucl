          2 (angle), 5 (magnitude), 7 (real), and 8 (imag)"
  endparam
  param tpower
    caption = "Trap Power"
    default = (0,1)
    hint = "Trap point t exponent if param 'Trap Transmute' is set to 't^power'"
  endparam
  param tiscale
    caption = "Trap Scale"
    default = 1.0
    hint = "This param can be used to scale the overall trap point t \
          before transmutation"
  endparam
  param threshold
    caption = "Threshold Value"
    default = 0.5
    hint = "Depth of trap well (maximum value that will be trapped) if one of the \
        'Threshold' options are chosen for param 'Trap What'; also, minimum value \
        that will be trapped if 'Trap What' is set to a 'Limit' option. Increase \
        value for limit traps"
  endparam
  param ringstyle
    caption = "Enable Rings?"
    default = FALSE
    hint = "If 'Enable Rings' is active, AND if param 'Trap What' is set to a \
        'Threshold' or 'Limit' option, then Threshold/Limit becomes a ring trap. \
        'Threshold Value' sets outer radius, 'Ring Width' sets inner radius"
  endparam
  param ringwidth
    caption = "Ring Width"
    default = 0.25
    hint = "If 'Enable Rings' is TRUE and 'Trap What' is set to either a 'Threshold' \
        option or a 'Limit' option, this parameter determines the width of the ring trap"
  endparam
  param realfront
