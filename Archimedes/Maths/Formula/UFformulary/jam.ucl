    elseif ( @realfront == 43 )
      tempx = temp2 * exp( temp2 )
    elseif ( @realfront == 44 )
      tempx = temp2 * exp( -temp2 )
    elseif ( @realfront == 45 )
      tempx = temp2 * exp( 1/temp2 )
    elseif ( @realfront == 46 )
      tempx = temp2 * exp( -1/temp2 )
    elseif ( @realfront == 47 )
      tempx = temp2 * temp2 * temp2
    elseif ( @realfront == 48 )
      tempx = 1 / ( temp2 * temp2 * temp2 )
    elseif ( @realfront == 49 )
      tempx = atan( 1 / temp2 )
    elseif ( @realfront == 50 )
