          ((@coordtype == "Parametric") && (@traptype != "functions")) || \
          ((@coordtype == "Mixed") && (@traptype == "oscillators")) || \
          ((@coordtype == "Mixed") && (@traptype == "mixed 1")) ) \
          && (@osc21amp != 0.0)
  endparam
  param oscpower21
    caption = "Set B Osc 1 Power?"
    default = FALSE
    hint = "If enabled, Set B Oscillator 1 result will be raised to the power set by \
            'Set B Osc 1 Exponent' before being combined with the other oscillators"
    visible = @showtrapfuncs && \
          ( ((@coordtype == "Polar") && (@traptype == "oscillators")) || \
          ((@coordtype == "Parametric") && (@traptype != "functions")) || \
          ((@coordtype == "Mixed") && (@traptype == "oscillators")) || \
          ((@coordtype == "Mixed") && (@traptype == "mixed 1")) ) \
