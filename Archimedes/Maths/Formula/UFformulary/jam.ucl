    caption = "Set A Osc 4 Exponent"
    default = 2.0
    hint = "If 'Set A Osc 4 Power' is enabled, this parameter sets the exponent that will be used"
    visible = @showtrapfuncs && \
          (@traptype != "functions") \
          && (@osc11amp != 0.0) && (@osc12amp != 0.0) && (@osc13amp != 0.0) && (@osc14amp != 0.0) && @oscpower14
  endparam
  param osc14sin
    caption = "SetA Osc4 Sine?"
    default = FALSE
    hint = "If enabled, then functions other than cosine can be used \
          for Set A's fourth oscillator"
    visible = @showtrapfuncs && (@traptype != "functions") \
          && (@osc11amp != 0.0) && (@osc12amp != 0.0) && (@osc13amp != 0.0) && (@osc14amp != 0.0)
  endparam
  param oscfunc14
    caption = "Set A Osc 4 Function"
    enum = "sine" "tan" "exp" "sec" "csc" "cotan" "log" "none---angle only"
