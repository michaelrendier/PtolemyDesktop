    endif ; realfront

    if @rfperturb
      tempx = @rfblend * tempx + rfbcomp * real(#z)
    endif ; @rfperturb

    temp2 = @ifscale * imag(#z)

    if ( @imagfront == 0 )
      tempy = temp2
    elseif ( @imagfront == 1 )
