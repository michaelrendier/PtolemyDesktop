  endparam
  param oscfunc13
    caption = "Set A Osc 3 Function"
    enum = "sine" "tan" "exp" "sec" "csc" "cotan" "log" "none---angle only"
    default = 0
    hint = "If 'Set A Osc 3 Sine' is enabled, than this parameter determines which \
          function is used in place of the cosine function"
    visible = @showtrapfuncs && (@traptype != "functions") && (@osc13amp != 0.0) && @osc13sin \
          && (@osc11amp != 0.0) && (@osc12amp != 0.0)
  endparam
  param oscoperation13
