      tempx = tempx * tempx
    elseif ( @realfront == 32 )
      tempx = 1/sin( temp2 )
      tempx = tempx * tempx
    elseif ( @realfront == 33 )
      tempx = temp2^(temp2)
      tempx = temp2^tempx
    elseif ( @realfront == 34 )
