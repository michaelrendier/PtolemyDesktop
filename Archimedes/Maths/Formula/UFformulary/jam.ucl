      tempx = cos(temp2)*log(temp2)
    elseif  @realback == 113
      tempx = sinh(temp2)*log(temp2)
    else ; @realback == 114
      tempx = cosh(temp2)*log(temp2)
    endif ; realback

    if @rbperturb
      tempx = @rbblend * tempx + rbbcomp * real(tempc)
    endif ; @rbperturb

    temp2 = @ibscale * imag(tempc)

    if ( @imagback == 0 )
      tempy = temp2
    elseif ( @imagback == 1 )
      tempy = 1/temp2
    elseif ( @imagback == 2 )
      tempy = temp2 * temp2
    elseif ( @imagback == 3 )
