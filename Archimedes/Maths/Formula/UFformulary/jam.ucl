      tempy = 1/cos( 1/temp2 )
    elseif ( @imagback == 67 )
      tempy = 1/sin( 1/temp2 )
    elseif ( @imagback == 68 )
      tempy = cotanh( temp2 )
    elseif ( @imagback == 69 )
      tempy = 1/cosh( temp2 )
    elseif ( @imagback == 70 )
