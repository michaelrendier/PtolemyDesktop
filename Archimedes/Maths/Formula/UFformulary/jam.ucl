      tempx = temp2 * exp( temp2 )
    elseif ( @realback == 44 )
      tempx = temp2 * exp( -temp2 )
    elseif ( @realback == 45 )
      tempx = temp2 * exp( 1/temp2 )
    elseif ( @realback == 46 )
      tempx = temp2 * exp( -1/temp2 )
    elseif ( @realback == 47 )
      tempx = temp2 * temp2 * temp2
    elseif ( @realback == 48 )
      tempx = 1 / ( temp2 * temp2 * temp2 )
    elseif ( @realback == 49 )
      tempx = atan( 1 / temp2 )
    elseif ( @realback == 50 )
      tempx = acos( 1 / temp2 )
    elseif ( @realback == 51 )
      tempx = asin( 1 / temp2 )
    elseif ( @realback == 52 )
      tempx = tan( temp2 ) / temp2
    elseif ( @realback == 53 )
      tempx = cotan( temp2 ) / temp2
    elseif ( @realback == 54 )
      tempx = 1 / ( temp2 * cos( temp2 ))
    elseif ( @realback == 55 )
      tempx = 1 / ( temp2 * sin( temp2 ))
