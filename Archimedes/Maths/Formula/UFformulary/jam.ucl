    elseif ( @imagback == 28 )
      tempy = 1/cos( temp2 )
    elseif ( @imagback == 29 )
      tempy = 1/sin( temp2 )
    elseif ( @imagback == 30 )
      tempy = cotan( temp2 )
      tempy = tempy * tempy
    elseif ( @imagback == 31 )
      tempy = 1/cos( temp2 )
      tempy = tempy * tempy
    elseif ( @imagback == 32 )
      tempy = 1/sin( temp2 )
      tempy = tempy * tempy
    elseif ( @imagback == 33 )
      tempy = temp2^(temp2)
      tempy = temp2^tempy
    elseif ( @imagback == 34 )
      tempy = temp2^(temp2)
      tempy = 1/( temp2^tempy )
    elseif ( @imagback == 35 )
      tempy = log(-temp2)
    elseif ( @imagback == 36 )
      tempy = 1/log( temp2 )
