  default = (1,0)
  endparam
  param exp9
  caption = "exponent 9"
  default = (1,0)
  endparam
  param exp10
  caption = "exponent 10"
  default = (1,0)
  endparam
  param op2
  caption = "operator 2"
  enum = "/""*""-""+""^"
  default = 3
  endparam
