ELSEIF (@op1 == 1); subtract
z = qq+(xx) - vv - yy / uu-@fn8 (ii^hh)
ELSEIF (@op1 == 2); add
z = qq+(xx) + vv - yy / uu-@fn8 (ii^hh)
