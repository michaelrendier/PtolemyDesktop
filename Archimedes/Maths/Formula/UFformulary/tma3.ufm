ELSEIF (@op2 == 4)
z = qq+(xx - vv) ^ yy + uu-@fn8 (hh*ii)
ENDIF
ELSEIF (@op3 == 04)
IF (@op2 == 0)
z = qq+(xx - vv) / yy ^ uu-@fn8 (hh*ii)
ELSEIF (@op2 == 1)
z = qq+(xx - vv) * yy ^ uu-@fn8 (hh*ii)
ELSEIF (@op2 == 2)
z = qq+(xx - vv) - yy ^ uu-@fn8 (hh*ii)
ELSEIF (@op2 == 3)
z = qq+(xx - vv) + yy ^ uu-@fn8 (hh*ii)
ELSEIF (@op2 == 4)
z = qq+(xx - vv) ^ yy ^ uu-@fn8 (hh*ii)
ENDIF
ENDIF

ELSEIF (@group == 2); middle 2
IF (@op3 == 0)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) / uu-@fn8 (hh*ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) / uu-@fn8 (hh*ii)
ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy) / uu-@fn8 (hh*ii)
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy) / uu-@fn8 (hh*ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) / uu-@fn8 (hh*ii)
ENDIF
ELSEIF (@op3 == 1)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) * uu-@fn8 (hh*ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) * uu-@fn8 (hh*ii)
ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy) * uu-@fn8 (hh*ii)
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy) * uu-@fn8 (hh*ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) * uu-@fn8 (hh*ii)
ENDIF
ELSEIF (@op3 == 2)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) - uu-@fn8 (hh*ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) - uu-@fn8 (hh*ii)
ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy) - uu-@fn8 (hh*ii)
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy) - uu-@fn8 (hh*ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) - uu-@fn8 (hh*ii)
ENDIF
ELSEIF (@op3 == 3)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) + uu-@fn8 (hh*ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) + uu-@fn8 (hh*ii)
ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy) + uu-@fn8 (hh*ii)
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy) + uu-@fn8 (hh*ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) + uu-@fn8 (hh*ii)
ENDIF
ELSEIF (@op3 == 04)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) ^ uu-@fn8 (hh*ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) ^ uu-@fn8 (hh*ii)
ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy) ^ uu-@fn8 (hh*ii)
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy) ^ uu-@fn8 (hh*ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) ^ uu-@fn8 (hh*ii)
ENDIF
ENDIF

ELSEIF (@group == 3); middle 3
IF (@op3 == 0)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy / uu-@fn8 (hh*ii))
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy / uu-@fn8 (hh*ii))
ELSEIF (@op2 == 2)
