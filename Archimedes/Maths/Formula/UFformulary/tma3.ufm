bailout:
  |z| < @bailout
  switch:
  type = "SpicyBrew11"
  bailout = @bailout
  fn1 = @fn1
  fn2 = @fn2
  fn3 = @fn3
  fn4 = @fn4
  fn5 = @fn5
  fn6 = @fn6
  fn7 = @fn7
  fn8 = @fn8
  fn9 = @fn9
  fn10 = @fn10
  fn11 = @fn11
  fn12 = @fn12
  eye = @eye
  frog = @frog
  hen = @hen
  maid = @maid
  bat = @bat
  t = @t
  a = @a
  b = @b
  dew = @dew
  op2 = @op2
  op3 = @op3
  op4 = @op4
  mode = switchMode
  switchMode = mode
  startSeed = #pixel
  group = @group
  exp1 = @exp1
  exp2 = @exp2
  exp3 = @exp3
  exp4 = @exp4
  exp5 = @exp5
  exp6 = @exp6
  exp7 = @exp7
  exp8 = @exp8
  exp9 = @exp9
  exp10 = @exp10
  exp11 = @exp11
 
default:
  title = "Spicy Brew 11"
  maxiter = 250
  periodicity = 0
  center = (0,-1)
  magn = .5
  param mode
  caption = "Current mode"
  default = 0
  enum = "Mandelbrot" "Julia"
  hint = "Shows the current mode for the formula."
  endparam
  param switchMode
  caption = "Switch to"
  default = 1
  enum = "Mandelbrot" "Julia"
  hint = "Sets the mode to switch to using the switch function."
  endparam
  complex param startSeed
  caption = "Start/Seed"
  default = (1,0)
