ELSEIF (@op3 == 3)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) + uu-@fn8 (hh/ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) + uu-@fn8 (hh/ii)
ELSEIF (@op2 == 2)
