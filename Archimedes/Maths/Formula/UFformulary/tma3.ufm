bailout:
  |z| < @bailout
  switch:
  type = "FatBrew05"
  bailout = @bailout
  fn1 = @fn1
  fn2 = @fn2
  fn3 = @fn3
  fn4 = @fn4
  fn5 = @fn5
  fn6 = @fn6
  fn7 = @fn7
  fn8 = @fn8
  fn9 = @fn9
  fn10 = @fn10
  eye = @eye
  frog = @frog
  hen = @hen
  maid = @maid
  bat = @bat
  t = @t
  ts = @ts
  dew = @dew
  op1 = @op1
  op2 = @op2
  op3 = @op3
  op4 = @op4
  mode = switchMode
  switchMode = mode
  startSeed = #pixel
  group = @group
  exp1 = @exp1
  exp2 = @exp2
  exp3 = @exp3
  exp4 = @exp4
  exp5 = @exp5
  exp6 = @exp6
  exp7 = @exp7
  exp8 = @exp8
  
default:
  title = "Fat Brew 05"
  maxiter = 250
  periodicity = 0
  center = (1.5,0.5)
  magn = .55
  param mode
  caption = "Current mode"
  default = 0
  enum = "Mandelbrot" "Julia"
  hint = "Shows the current mode for the formula."
  endparam
  param switchMode
  caption = "Switch to"
  default = 1
  enum = "Mandelbrot" "Julia"
  hint = "Sets the mode to switch to using the switch function."
