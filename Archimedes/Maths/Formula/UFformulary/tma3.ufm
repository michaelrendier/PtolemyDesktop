  fn12 = @fn12
  a = @a
  b = @b
  eye = @eye
  frog = @frog
  hen = @hen
  maid = @maid
  bat = @bat
  t = @t
  dew = @dew
  op2 = @op2
  op3 = @op3
  op4 = @op4
  mode = switchMode
  switchMode = mode
  startSeed = #pixel
  group = @group
  exp1 = @exp1
