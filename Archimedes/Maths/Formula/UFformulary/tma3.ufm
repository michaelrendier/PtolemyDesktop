z = qq+(xx) - (vv * yy ^ uu-@fn8 (hh*ii))
ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy ^ uu-@fn8 (hh*ii))
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy ^ uu-@fn8 (hh*ii))
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy ^ uu-@fn8 (hh*ii))
ENDIF
ENDIF
ENDIF


ELSEIF (@op4 == 1)
IF (@group == 0); inner
IF (@op3 == 0)
IF (@op2 == 0)
z = qq+(xx) - vv / yy / uu*@fn8 (hh*ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - vv * yy / uu*@fn8 (hh*ii)
ELSEIF (@op2 == 2)
z = qq+(xx) - vv - yy / uu*@fn8 (hh*ii)
