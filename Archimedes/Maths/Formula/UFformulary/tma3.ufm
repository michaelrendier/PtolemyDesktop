  caption = "exponent 12"
  default = (1,0)
  endparam
  param op2
  caption = "operator 2"
  enum = "/""*""-""+""^"
  default = 3
  endparam
  param op3
  caption = "operator 3"
  enum = "/""*""-""+""^"
  default = 1
  endparam
  param op4
  caption = "operator 4"
  enum = "/""*""-""+""^"
  default = 3
  endparam
  param group
  caption = "grouping"
  default = 3
  enum = "1""2""3""4"
  endparam
  func fn1
  Caption = "function 1"
  default = exp ()
  endfunc
  func fn2
  Caption = "function 2"
  default = flip ()
  endfunc
  func fn3
  Caption = "function 3"
  default = ident ()
  endfunc
  func fn4
