  default = (1,0)
  endparam
  param op2
  caption = "operator 2"
  enum = "/""*""-""+""^"
  default = 2
  endparam
  param op3
  caption = "operator 3"
  enum = "/""*""-""+""^"
  default = 1
  endparam
  param op4
  caption = "operator 4"
  enum = "/""*""-""+""^"
  default = 3
  endparam
