ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy) * uu-@fn8 (hh/ii)
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy) * uu-@fn8 (hh/ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) * uu-@fn8 (hh/ii)
ENDIF
ELSEIF (@op3 == 2)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) - uu-@fn8 (hh/ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) - uu-@fn8 (hh/ii)
ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy) - uu-@fn8 (hh/ii)
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy) - uu-@fn8 (hh/ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) - uu-@fn8 (hh/ii)
ENDIF
ELSEIF (@op3 == 3)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) + uu-@fn8 (hh/ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) + uu-@fn8 (hh/ii)
ELSEIF (@op2 == 2)
z = qq+(xx) - (vv - yy) + uu-@fn8 (hh/ii)
ELSEIF (@op2 == 3)
z = qq+(xx) - (vv + yy) + uu-@fn8 (hh/ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) + uu-@fn8 (hh/ii)
ENDIF
ELSEIF (@op3 == 04)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) ^ uu-@fn8 (hh/ii)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) ^ uu-@fn8 (hh/ii)
ELSEIF (@op2 == 2)
