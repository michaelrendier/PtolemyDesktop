ELSEIF (@op3 == 2)
IF (@op2 == 0)
z = qq+(xx) - vv / yy - uu-@fn8 (ii^hh)
ELSEIF (@op2 == 1)
z = qq+(xx) - vv * yy - uu-@fn8 (ii^hh)
ELSEIF (@op2 == 2)
z = qq+(xx) - vv - yy - uu-@fn8 (ii^hh)
ELSEIF (@op2 == 3)
