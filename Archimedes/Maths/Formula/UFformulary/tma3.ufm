SpicyBrew10 {
  ; Toby Marshall, Aug. 2002
  ; The Julia switch is incorporated in this
  ; formula. All functions and parameters
  ; can be varied to explore different Julia   
  ; sets when using it, and can also be 
  ; changed after the Julia is set. 

  ; Many thanks to Joe Maddry and Ken Childress
  ; for their invaluable help.
   
init:
  complex c = #pixel
  complex z = @startSeed
  complex frog = @frog*(0.0,1.0)
   if (@mode == "Mandelbrot") 
     z = @startSeed
      endif
   if @mode == "Julia"
     z = #pixel
     c = @startSeed
      endif  
loop:
 qq = fn1(c^@exp8^@fn10(c)^@exp5 + @maid)
 xx = fn2(real(fn3(z^@exp9-@fn11(c+ @a)^@exp1) + @eye))
 vv = fn4(imag(@fn5(z^@exp10/@fn12(c+@b)^@exp2) + frog)) 
 yy = @fn6(c^@exp4 +@hen)
 uu = @fn7(z^@exp3 + @bat)
 hh = @fn8(z^@exp6 / @dew)
 ii = @fn9(c^@exp11^c^@exp7+@t)

IF (@op4 == 0)
IF (@group == 0); inner
IF (@op3 == 0)
IF (@op2 == 0)
z = qq+(xx) - vv / yy / uu-@fn8 (ii/hh)
