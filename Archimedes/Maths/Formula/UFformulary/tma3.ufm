z = qq+(xx) - (vv + yy) / uu-@fn8 (hh/ii)
ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) / uu-@fn8 (hh/ii)
ENDIF
ELSEIF (@op3 == 1)
IF (@op2 == 0)
