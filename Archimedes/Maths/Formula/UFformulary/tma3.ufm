ELSEIF (@op4 == 1)
IF (@group == 0); inner
IF (@op3 == 0)
IF (@op2 == 0)
z = qq+(xx) - vv / yy / uu*aa
ELSEIF (@op2 == 1)
z = qq+(xx) - vv * yy / uu*aa
ELSEIF (@op2 == 2)
