ELSEIF (@op2 == 4)
z = qq+(xx) - vv ^ yy ^ uu-@fn8 (hh*ii)
ENDIF
ENDIF

ELSEIF (@group == 1); middle 1
IF (@op3 == 0)
IF (@op2 == 0)
z = qq+(xx - vv) / yy / uu-@fn8 (hh*ii)
ELSEIF (@op2 == 1)
z = qq+(xx - vv) * yy / uu-@fn8 (hh*ii)
ELSEIF (@op2 == 2)
z = qq+(xx - vv) - yy / uu-@fn8 (hh*ii)
ELSEIF (@op2 == 3)
