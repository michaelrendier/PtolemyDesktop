ELSEIF (@op1 == 2); add
z = qq+(xx) + vv ^ yy + uu-@fn8 (hh^ii)
ENDIF
ENDIF
ELSEIF (@op3 == 04); exponent
IF (@op2 == 0); divide
IF (@op1 == 0); multiply
z = qq+(xx) * vv / yy ^ uu-@fn8 (hh^ii)
ELSEIF (@op1 == 1); subtract
z = qq+(xx) - vv / yy ^ uu-@fn8 (hh^ii)
ELSEIF (@op1 == 2); add
z = qq+(xx) + vv / yy ^ uu-@fn8 (hh^ii)
