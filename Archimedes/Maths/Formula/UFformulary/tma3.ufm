  caption = "grouping"
  default = 0
  enum = "1""2""3""4"
  endparam
  func fn1
  Caption = "function 1"
  default = exp ()
  endfunc
  func fn2
  Caption = "function 2"
  default = flip ()
  endfunc
  func fn3
  Caption = "function 3"
  default = ident ()
  endfunc
  func fn4
  Caption = "function 4"
  default = ident ()
  endfunc
  func fn5
  Caption = "function 5"
  default = ident ()
  endfunc
  func fn6
