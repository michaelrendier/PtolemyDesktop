  caption = "bat wings"
  default = (0.0,0.0)
  endparam
  param maid
  caption = "maiden's tears"
  default = (0.0,0.0)
  endparam
  param t
  caption = "thistledown"
  default = (0.0,0.0)
  endparam
  param dew
  caption = "dewdrops"
  default = (0.0,0.0)
  endparam
   param a
  caption = "crab apples"
  default = (0.0,0.0)
  endparam
