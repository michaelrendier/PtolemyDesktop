bailout:
  |z| < @bailout
  switch:
  type = "FatBrew10"
  bailout = @bailout
  fn1 = @fn1
  fn2 = @fn2
  fn3 = @fn3
  fn4 = @fn4
  fn5 = @fn5
  fn6 = @fn6
