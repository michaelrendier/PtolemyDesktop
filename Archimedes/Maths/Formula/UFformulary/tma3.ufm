ELSEIF (@op2 == 4)
z = qq+(xx - vv) ^ yy ^ uu-@fn8 (ii-hh)
ENDIF
ENDIF

ELSEIF (@group == 2); middle 2
IF (@op3 == 0)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy) / uu-@fn8 (ii-hh)
ELSEIF (@op2 == 1)
z = qq+(xx) - (vv * yy) / uu-@fn8 (ii-hh)
ELSEIF (@op2 == 2)
