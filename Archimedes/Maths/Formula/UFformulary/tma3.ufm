  frog = @frog
  hen = @hen
  maid = @maid
  bat = @bat
  t = @t
  a = @a
  b = @b
  dew = @dew
  op2 = @op2
  op3 = @op3
  op4 = @op4
  mode = switchMode
  switchMode = mode
  startSeed = #pixel
  group = @group
