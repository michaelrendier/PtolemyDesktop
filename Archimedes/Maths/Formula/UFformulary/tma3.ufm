ELSEIF (@op2 == 4)
z = qq+(xx) - (vv ^ yy) ^ uu-@fn8 (ii-hh)
ENDIF
ENDIF

ELSEIF (@group == 3); middle 3
IF (@op3 == 0)
IF (@op2 == 0)
z = qq+(xx) - (vv / yy / uu-@fn8 (ii-hh))
ELSEIF (@op2 == 1)
