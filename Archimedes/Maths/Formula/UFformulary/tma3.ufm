 uu = @fn7(z^@exp3 + @bat)
 aa = @fn8(z^@exp6+@t)
IF (@op4 == 0); divide
IF (@group == 0); inner
IF (@op3 == 0); divide
IF (@op2 == 0); divide
z = qq+(xx) - vv / yy / uu-aa
