ELSEIF (@op2 == 4); exponent
z = qq+(xx - vv) ^ yy - uu-@fn8 (ii/hh)
ENDIF
ELSEIF (@op3 == 3); add
IF (@op2 == 0); divide
z = qq+(xx - vv) / yy + uu-@fn8 (ii/hh)
ELSEIF (@op2 == 1); multiply
z = qq+(xx - vv) * yy + uu-@fn8 (ii/hh)
ELSEIF (@op2 == 2); subtract
z = qq+(xx - vv) - yy + uu-@fn8 (ii/hh)
ELSEIF (@op2 == 3); add
z = qq+(xx - vv) + yy + uu-@fn8 (ii/hh)
ELSEIF (@op2 == 4); exponent
z = qq+(xx - vv) ^ yy + uu-@fn8 (ii/hh)
ENDIF
ELSEIF (@op3 == 04); exponent
IF (@op2 == 0); divide
z = qq+(xx - vv) / yy ^ uu-@fn8 (ii/hh)
ELSEIF (@op2 == 1); multiply
z = qq+(xx - vv) * yy ^ uu-@fn8 (ii/hh)
ELSEIF (@op2 == 2); subtract
