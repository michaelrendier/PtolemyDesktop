ENDIF
ELSEIF (@op2 == 2); subtract
IF (@op1 == 0); multiply
z = qq+(xx) * vv - yy / uu-@fn8 (hh*ii)
ELSEIF (@op1 == 1); subtract
z = qq+(xx) - vv - yy / uu-@fn8 (hh*ii)
ELSEIF (@op1 == 2); add
z = qq+(xx) + vv - yy / uu-@fn8 (hh*ii)
ENDIF
ELSEIF (@op2 == 3); add
IF (@op1 == 0); multiply
z = qq+(xx) * vv + yy / uu-@fn8 (hh*ii)
ELSEIF (@op1 == 1); subtract
z = qq+(xx) - vv + yy / uu-@fn8 (hh*ii)
ELSEIF (@op1 == 2); add
