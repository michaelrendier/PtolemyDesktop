  endparam
  param exp8
  caption = "exponent 8"
  default = (1,0)
  endparam
  param exp9
  caption = "exponent 9"
  default = (1,0)
  endparam
  param exp10
  caption = "exponent 10"
  default = (1,0)
  endparam
  param op2
