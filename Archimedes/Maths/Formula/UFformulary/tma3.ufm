  default = ident ()
  endfunc
  func fn8
  Caption = "function 8"
  default = ident ()
  endfunc
  func fn9
  Caption = "function 9"
  default = ident ()
  endfunc
  func fn10
  Caption = "function 10"
  default = ident ()
  endfunc
  func fn11
  Caption = "function 11"
  default = ident ()
