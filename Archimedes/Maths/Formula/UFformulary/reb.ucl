              color2 = gradient(colr/2)
              colorf = compose(color1,blend(color2,mergedarken(color1,color2),alpha(color1)),1.0)
              colorf = blend(colorf,rgb(0,0,0),lds/@sdis)
              if @tparent
                it = jt
                color colorlayer = rgba(0,0,0,1)
                color colorlayer2 = rgba(0,0,0,0)
                while it >= 0
                  if ltt[it] !=0
                    colorft[it] = gradient(colrT[it]/2)
                    colorft[it] = blend(colorft[it],rgb(0,0,0),ldst[it]/@sdis)
                    if @tmerge == "Normal"
