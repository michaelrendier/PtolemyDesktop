      exptrap_p = exptrap_p + exp(-cabs(f_pi[j]))
    endif
    d = @dmod*distscales3d[j]*abs(|z1[j]| - |f_pi[j]|)
    if @trapvar == 1
      d = abs(d*d - d)
    elseif @trapvar == 2
      d = abs(d*d*d - d)
    elseif @trapvar == 3
      d = abs(d*d*d -d*d +d)
    elseif @trapvar == 4
      if @version >= 1.3
        d = abs(d - |f_pi[j]|)
      else
        d = abs(d + |f_pi[j]|)
