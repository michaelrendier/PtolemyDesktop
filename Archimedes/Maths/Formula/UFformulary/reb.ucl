            texture[1+(round((@hite*abs(imag(trap_p))+1)*(sum*@fbms+1)*irotx/@scale) % 100),\
            1+(round((@hite*abs(imag(trap_p))+1)*(sum*@fbms+1)*iroty/@scale) % 100)]

    ELSEIF @color_mode == 9
      float angle = atan2(trap_p)
      IF angle < 0
        angle = angle + 2 * #pi
