    colorMap [7,0] = @silverBlueAlt8Max8, colorMap [7,1] = @silverBlueAlt8Min8
    ranges = 8
    offset = @colorOffset

  elseif (@colorPreset == "Gold/Silver Alt 8")
    ;
    colorMap [0,0] = @goldSilverAlt8Max1, colorMap [0,1] = @goldSilverAlt8Min1
    colorMap [1,0] = @goldSilverAlt8Max2, colorMap [1,1] = @goldSilverAlt8Min2
    colorMap [2,0] = @goldSilverAlt8Max3, colorMap [2,1] = @goldSilverAlt8Min3
