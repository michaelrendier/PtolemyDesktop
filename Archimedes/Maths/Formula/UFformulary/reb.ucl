                color1 = blend(colorMap[rangeNum,1], blend(colorMap[rangeNum,0],@hcolor,hval^@hblend), colorPos^@cblend-am)
                color2 = blend(colorMap[rangeNum,1], blend(colorMap[rangeNum,0],@hcolor,hval^@hblend), colorPos^@cblend)
                color2 = compose(color1,blend(color2,mergedarken(color1,color2),alpha(color1)),1.0)

