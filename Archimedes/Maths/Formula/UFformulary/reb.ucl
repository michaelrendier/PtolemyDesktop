heading
  caption = "Morph Parameters  [active]"
  visible = (@change != 0 || @exp1 != (1,0) || @exp2 != (1,0) || \
            @exp3 != (1,0) || @tw != (0,0) || @tw2 != (0,0) || \
            @tw3 != (0,0) || @tha2 == true)&& @expert
endheading

  param showm
