  ; Iterate the Sprott3D formula
    att_iter = 0
    while att_iter < max_s3d_iterations[j]
      pxx = px[j]
      pyy = py[j]
      px[j] = s3d1[j] + s3d2[j]*px[j] + s3d3[j]*px[j]*px[j] + s3d4[j]*px[j]*py[j] \
              + s3d5[j]*px[j]*pz[j] + s3d6[j]*py[j] + s3d7[j]*py[j]*py[j] + \
              s3d8[j]*py[j]*pz[j] + s3d9[j]*pz[j] + s3d10[j]*pz[j]*pz[j]
      py[j] = s3d11[j] + s3d12[j]*pxx + s3d13[j]*pxx*pxx + s3d14[j]*pxx*py[j] \
              + s3d15[j]*pxx*pz[j] + s3d16[j]*py[j] + s3d17[j]*py[j]*py[j] + \
              s3d18[j]*py[j]*pz[j] + s3d19[j]*pz[j] + s3d20[j]*pz[j]*pz[j]
      pz[j] = s3d21[j] + s3d22[j]*pxx + s3d23[j]*pxx*pxx + s3d24[j]*pxx*pyy + \
              s3d25[j]*pxx*pz[j] + s3d26[j]*pyy + s3d27[j]*pyy*pyy + \
              s3d28[j]*pyy*pz[j] + s3d29[j]*pz[j] + s3d30[j]*pz[j]*pz[j]
      att_iter = att_iter + 1
    endwhile
    pp[j] = px[j] + flip(py[j]) + pz[j]*s3dw[j]
    if j == 0
      f_pi[j] = @fn5A(pp[j]+startoffset[j])
    else
      f_pi[j] = @fn5B(pp[j]+startoffset[j])
