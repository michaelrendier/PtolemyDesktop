      ENDIF
      af1 = 0.1*pa[j]*(1+sin(theta))
      af2 = 0.1*pb[j]*cos(theta)*(1+sin(theta))
      astroid = (af1 + flip(af2))
      f_p = z1 - astroid+start[j]
    ELSEIF distvar[j] == 45 ; Keratoid Cusp
       cx = real(z2)
       qa = 1
       qb = -cx^2
       qc = -cx^5
       if negroot[j] == true
         qy = (-qb - (qb^2 - 4*qa*qc)^0.5)/(2*qa)
       else
         qy = (-qb + (qb^2 - 4*qa*qc)^0.5)/(2*qa)
       endif
       f_p = z1 - 2.5*pa[j]*(cx + flip(qy))+start[j]
    ELSEIF distvar[j] == 71 ; Serpentine Curve
