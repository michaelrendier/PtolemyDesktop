             || @distvarA=="Hipopede" || @distvarA=="Maltese Cross" || @distvarA=="Ophiuride" || @distvarA=="Quadratrix of Hippias" \
             || @distvarA=="Poinsot Spiral 1" || @distvarA=="Poinsot Spiral 2" || @distvarA=="Quadrifolium" || @distvarA=="Scarabaeus" \
             || @distvarA=="Semicubical Parabola" || @distvarA=="Swastika Curve" || @distvarA=="Trifolium" || @distvarA=="Tschirnhausen Cubic" \
