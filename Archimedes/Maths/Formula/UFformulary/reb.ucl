    elseif @trapvar == 5
      d = abs(d - cabs(fn3(f_pi[j])))
    elseif @trapvar == 6
      d = cabs((z1[j]-f_pi[j])*(d/10-f_pi[j]))
    elseif @trapvar == 7
      d = cabs(fn3(f_pi[j])*(d/10-z1[j]+f_pi[j]))
    elseif @trapvar == 8
      d = cabs(fn3(f_pi[j])*(d/10-(x+y)))
    elseif @trapvar == 9
      d = cabs(fn3(f_pi[j])*(d/10-(x*y)))
    endif
    distsum = d + distsum
    distave = distsum/exptrap_z
  elseif types[j] == 7  ; Pickover
    px[j] = real(z1[j])*pks[j]
    py[j] = imag(z1[j])*pks[j]
    pz[j] = pkz[j]*pks[j]

  ; Iterate the Pickover formula
    att_iter = 0
    while att_iter < max_pk_iterations[j]
      pxx = px[j]
      if j == 0
        px[j] = real(@pkfunc1A(py[j]*pk1[j]) - pz[j]*@pkfunc2A(px[j]*pk2[j]))
        py[j] = real(pz[j]*@pkfunc3A(pxx*pk3[j]) - @pkfunc4A(py[j]*pk4[j]))
