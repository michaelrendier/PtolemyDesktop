      #index = angle*0.99*(1+@fbmf*(sum+1)*0.5)/(1+@fbmf)+t+ @wate*\
            texture[1+(round((@hite*cabs(trap_z)+1)*(sum*@fbms+1)*irotx/@scale) % 100),\
            1+(round((@hite*cabs(trap_z)+1)*(sum*@fbms+1)*iroty/@scale) % 100)]

    ELSEIF @color_mode == 6
      #index = cabs(trap_p)*0.99*(1+@fbmf*(sum+1)*0.5)/(1+@fbmf)+t+ @wate*\
            texture[1+(round((@hite*cabs(trap_p)+1)*(sum*@fbms+1)*irotx/@scale) % 100),\
