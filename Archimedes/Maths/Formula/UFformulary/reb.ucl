                color colorlayer2 = rgba(0,0,0,0)
                while it >= 0
                  if ltt[it] !=0
                    colorft[it] = blend(colorMap[rangeNumT[it],1], blend(colorMap[rangeNumT[it],0],@hcolor,hvalt[it]^@hrblendt), colorPosT[it]^@rblendt)
                    colorft[it] = blend(colorft[it],rgb(0,0,0),ldst[it]/@sdis)
                    if @tmerge == "Normal"
                      colorlayer = compose(colorlayer, blend(colorft[it], mergenormal(colorlayer, colorft[it]), alpha(colorlayer)), (1-@tparentval))
