             || @distvarA=="Poinsot Spiral 1" || @distvarA=="Poinsot Spiral 2" || @distvarA=="Teardrop Curve" || @distvarA=="Polytrope") \
             && @version == "1.1" && @typeA == 9
  endparam
  param t2A
    caption = "Angle type"
    default = 1
    enum = "Atan2" "Atan"
    visible=(@distvarA=="Lemniscate" || @distvarA=="Cardiod" || @distvarA=="Conchoid" || @distvarA=="Cycloid" \
