  param apwrA
    caption = "Power"
    default = (3.0,3.0)
    visible=(@distvarA=="Astroid" || @distvarA=="Ellipse Evolute" || @distvarA=="Bean") \
             && @version == "1.1"
  endparam
  func afn1A
    caption = "Polar Fn 1"
