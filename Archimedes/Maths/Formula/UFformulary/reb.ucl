            texture[1+(round((@hite*exptrap_p*cabs(trap_p)+1)*(sum*@fbms+1)*irotx/@scale) % 100),\
            1+(round((@hite*exptrap_p*cabs(trap_p)+1)*(sum*@fbms+1)*iroty/@scale) % 100)]

