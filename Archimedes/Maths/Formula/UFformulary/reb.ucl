              endif
            elseif @colormethod=="Simple traps" || @colormethod=="Orbit traps"
              if @mask && !@rmask && closest > @threshold
                frac[i,j] = -1
              endif
              if @rmask == true && closest <= @threshold
                frac[i,j] = -1
              endif
              ez = cos(closest)+flip(sin(closest))
              closest = abs(atan2(ez)/(#pi))
              if frac[i,j] >= 0
                if @color_mode == "Distance"
                  frac[i,j] = closest
                else
                  frac[i,j] = trap_iter
                endif
              endif
              if closest >mxi
                mxi = closest
              endif
            endif
          else
            frac[i,j] = 0
          endif
          j = j + 1
          k = 0
          expiter = 0
          closest = 1e318
        endwhile
        i = i + 1
        j = 0
      endwhile
    elseif @fctltype == "Cayley Julia"
      closest = 1e318
      fcenter = @fccenter
