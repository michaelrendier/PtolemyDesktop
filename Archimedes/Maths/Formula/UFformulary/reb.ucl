texture[ 77, 100] = 0.922
texture[ 78, 100] = 0.867
texture[ 79, 100] = 0.824
texture[ 80, 100] = 0.624
texture[ 81, 100] = 0.337
texture[ 82, 100] = 0.173
texture[ 83, 100] = 0.420
texture[ 84, 100] = 0.647
texture[ 85, 100] = 0.212
texture[ 86, 100] = 0.447
texture[ 87, 100] = 0.745
texture[ 88, 100] = 0.694
texture[ 89, 100] = 0.608
texture[ 90, 100] = 0.471
texture[ 91, 100] = 0.529
