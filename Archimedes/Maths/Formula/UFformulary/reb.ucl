        IF angle < 0
          angle = angle + 2 * #pi
        ENDIF
        angle = 1 / (2 * #pi) * angle
        #index = angle*0.99*(1+@fbmf*(sum+1)*0.5)/(1+@fbmf)+t+ @wate*\
            texture[1+(round((@hite*cabs(trap_z)+1)*(sum*@fbms+1)*irotx/@scale) % 100),\
