      af1 = 0.2*pa[j]*cotan(theta)
      af2 = 0.2*pb[j]*sin(theta)*cos(theta)
      astroid = (af1 + flip(af2))
      f_p = z1 - astroid+start[j]
    ELSEIF distvar[j] == 49 ; Line
