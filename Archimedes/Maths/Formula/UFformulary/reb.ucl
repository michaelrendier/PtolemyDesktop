      d = abs(d*d*d - d)
    elseif @trapvar == 3
      d = abs(d*d*d -d*d +d)
    elseif @trapvar == 4
      if @version >= 1.3
        d = abs(d - |f_pi[j]|)
      else
        d = abs(d + |f_pi[j]|)
